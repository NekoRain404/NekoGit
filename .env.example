# Session encryption key (32-byte hex, required for multi-user mode)
NUXT_SESSION_PASSWORD=

# Auth mode: PAT login (default), OAuth, or personal mode
NUXT_AUTH_PAT_ENABLED=true
NUXT_AUTH_GITHUB_OAUTH_ENABLED=false
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Personal mode (single-user self-hosted)
# Lock password must be at least 12 bytes; cookie secret at least 32 bytes (production hard-fail).
NUXT_AUTH_PERSONAL_MODE_ENABLED=false
NUXT_GIT_PULSE_AUTH_GITHUB_TOKEN=
NUXT_GIT_PULSE_AUTH_PERSONAL_PASSWORD=
NUXT_GIT_PULSE_AUTH_PERSONAL_COOKIE_SECRET=

# Session cookie security (set to false for Tauri desktop over HTTP)
NUXT_NEKOGIT_AUTH_SESSION_COOKIE_SECURE=true

# Only enable when NekoGit sits behind a trusted reverse proxy that sets X-Forwarded-For.
# When false (default), unlock/PAT rate limits key on the direct socket IP (XFF is ignored).
# NUXT_NEKOGIT_AUTH_TRUST_PROXY=false

# User settings storage
NUXT_NEKOGIT_USER_SETTINGS_STORAGE_DRIVER=fs
# NUXT_NEKOGIT_USER_SETTINGS_STORAGE_BASE=./.data/user-settings

# Upstash Redis (optional, for production deployments)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
