{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for NekoGit.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-file",
    "notification:default",
    "allow-desktop-autostart-status",
    "allow-desktop-checkout-remote-local-repository-branch",
    "allow-desktop-clone-repository",
    "allow-desktop-commit-local-repository-changes",
    "allow-desktop-create-local-repository-branch",
    "allow-desktop-fetch-local-repository",
    "allow-desktop-local-repository-branches",
    "allow-desktop-local-repository-changed-files",
    "allow-desktop-local-repository-commit-history",
    "allow-desktop-local-repository-file-diff",
    "allow-desktop-local-repository-git-status",
    "allow-desktop-local-repository-status",
    "allow-desktop-diagnostics-report",
    "allow-desktop-runtime-info",
    "allow-desktop-open-app-data",
    "allow-desktop-open-server-log",
    "allow-desktop-open-github",
    "allow-desktop-open-github-url",
    "allow-desktop-open-local-repository",
    "allow-desktop-open-local-repository-path",
    "allow-desktop-open-local-repository-terminal",
    "allow-desktop-pull-local-repository",
    "allow-desktop-push-local-repository",
    "allow-desktop-read-github-cli-token",
    "allow-desktop-restart-bundled-server",
    "allow-desktop-server-status",
    "allow-desktop-set-autostart-enabled",
    "allow-desktop-set-navigation-state",
    "allow-desktop-stash-local-repository-changes",
    "allow-desktop-set-unread-count",
    "allow-desktop-set-window-title",
    "allow-desktop-show-window",
    "allow-desktop-switch-local-repository-branch"
  ]
}
